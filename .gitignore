# ==========================================
# PressOn AI - Root .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Production build
dist/
**/dist/

# Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# Environment Variables
.env
*.env
!.env.example
!**/.env.example

# Django Local Database & Media
*.sqlite3
*.sqlite3-journal
**/media/
staticfiles/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Model weights
*.pt
!**/ai/weights/best.pt

# IDE / OS Specific Files
.vscode/
.idea/
Thumbs.db
.DS_Store
